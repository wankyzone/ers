CREATE INDEX "errands_status_idx" ON "public"."errands" USING "btree" ("status");



CREATE UNIQUE INDEX "profiles_email_unique" ON "public"."profiles" USING "btree" ("lower"("email"));



ALTER TABLE ONLY "public"."audit_logs"
    ADD CONSTRAINT "audit_logs_actor_id_fkey" FOREIGN KEY ("actor_id") REFERENCES "auth"."users"("id");



ALTER TABLE ONLY "public"."errand_events"
    ADD CONSTRAINT "errand_events_errand_id_fkey" FOREIGN KEY ("errand_id") REFERENCES "public"."errands"("id") ON DELETE CASCADE;



ALTER TABLE ONLY "public"."jobs"
    ADD CONSTRAINT "jobs_client_id_fkey" FOREIGN KEY ("client_id") REFERENCES "public"."users"("id");



ALTER TABLE ONLY "public"."jobs"
    ADD CONSTRAINT "jobs_runner_id_fkey" FOREIGN KEY ("runner_id") REFERENCES "public"."users"("id");



ALTER TABLE ONLY "public"."runners"
    ADD CONSTRAINT "runners_id_fkey" FOREIGN KEY ("id") REFERENCES "public"."users"("id") ON DELETE CASCADE;



ALTER TABLE ONLY "public"."transactions"
    ADD CONSTRAINT "transactions_errand_id_fkey" FOREIGN KEY ("errand_id") REFERENCES "public"."errands"("id");



CREATE POLICY "Allow insert own profile" ON "public"."profiles" FOR INSERT WITH CHECK (("auth"."uid"() = "id"));



CREATE POLICY "Allow select own profile" ON "public"."profiles" FOR SELECT USING (("auth"."uid"() = "id"));



CREATE POLICY "Allow users to insert own profile" ON "public"."profiles" FOR INSERT WITH CHECK (("auth"."uid"() = "id"));



CREATE POLICY "Audit logs: admin read" ON "public"."audit_logs" FOR SELECT USING ((EXISTS ( SELECT 1
   FROM "public"."profiles"
  WHERE (("profiles"."id" = "auth"."uid"()) AND ("profiles"."role" = 'admin'::"text")))));



CREATE POLICY "Audit logs: service insert" ON "public"."audit_logs" FOR INSERT WITH CHECK (true);



CREATE POLICY "Clients can insert errands" ON "public"."errands" FOR INSERT WITH CHECK (("auth"."uid"() = "client_id"));



CREATE POLICY "Open errands visibility" ON "public"."errands" FOR SELECT USING (true);



CREATE POLICY "Profiles: read own" ON "public"."profiles" FOR SELECT USING (("auth"."uid"() = "id"));



CREATE POLICY "Profiles: update own" ON "public"."profiles" FOR UPDATE USING (("auth"."uid"() = "id"));



CREATE POLICY "Runners can update errands" ON "public"."errands" FOR UPDATE USING ((("auth"."uid"() = "assigned_runner_id") OR ("auth"."uid"() = "client_id")));



CREATE POLICY "Users can insert own profile" ON "public"."profiles" FOR INSERT WITH CHECK (("auth"."uid"() = "id"));



CREATE POLICY "Users can read own profile" ON "public"."profiles" FOR SELECT USING (("auth"."uid"() = "id"));



CREATE POLICY "Users can read own wallet" ON "public"."wallets" FOR SELECT USING (("auth"."uid"() = "user_id"));



CREATE POLICY "Users can update own profile" ON "public"."profiles" FOR UPDATE USING (("auth"."uid"() = "id"));



CREATE POLICY "Users can update own wallet" ON "public"."wallets" FOR UPDATE USING (("auth"."uid"() = "user_id"));



CREATE POLICY "allow_insert_for_authenticator" ON "public"."profiles" FOR INSERT TO "authenticated", "anon" WITH CHECK (true);



CREATE POLICY "allow_insert_from_trigger" ON "public"."profiles" FOR INSERT WITH CHECK (true);



CREATE POLICY "allow_profile_insert" ON "public"."profiles" FOR INSERT WITH CHECK (true);



ALTER TABLE "public"."audit_logs" ENABLE ROW LEVEL SECURITY;


ALTER TABLE "public"."kyc_profiles" ENABLE ROW LEVEL SECURITY;


ALTER TABLE "public"."otp_codes" ENABLE ROW LEVEL SECURITY;


ALTER TABLE "public"."profiles" ENABLE ROW LEVEL SECURITY;


CREATE POLICY "profiles_insert_authenticated" ON "public"."profiles" FOR INSERT TO "authenticated" WITH CHECK (true);



CREATE POLICY "read_available_errands" ON "public"."errands" FOR SELECT USING ((("status" = 'created'::"text") OR ("assigned_runner_id" = "auth"."uid"())));



CREATE POLICY "runner_read_self" ON "public"."runners" FOR SELECT USING (("auth"."uid"() = "id"));



