CREATE INDEX "errand_events_created_at_idx" ON "public"."errand_events" USING "btree" ("created_at" DESC);



CREATE INDEX "errand_events_errand_id_idx" ON "public"."errand_events" USING "btree" ("errand_id");



CREATE INDEX "errand_events_event_type_idx" ON "public"."errand_events" USING "btree" ("event_type");



CREATE INDEX "errands_client_idx" ON "public"."errands" USING "btree" ("client_id");



