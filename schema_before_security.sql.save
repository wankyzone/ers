);


ALTER TABLE "public"."orchestrator_retry_log" OWNER TO "postgres";


CREATE TABLE IF NOT EXISTS "public"."otp_codes" (
    "id" "uuid" DEFAULT "extensions"."uuid_generate_v4"() NOT NULL,
    "user_id" "uuid",
    "code" "text",
    "expires_at" timestamp without time zone,
